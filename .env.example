# Public by design — this is just the webhook URL the lead form posts to.
# Reuses Project #1's existing n8n lead-qualification webhook; this website
# has no backend of its own and no other secrets.
#
# Local dev against a locally running n8n:
#   NEXT_PUBLIC_N8N_LEAD_WEBHOOK_URL=http://localhost:5678/webhook/lead-qualification
#
# Production: point this at a PERSISTENT public n8n endpoint. The Cloudflare
# quick-tunnel URL used during development is temporary and changes on every
# restart — do not treat it as production-ready.
NEXT_PUBLIC_N8N_LEAD_WEBHOOK_URL=
